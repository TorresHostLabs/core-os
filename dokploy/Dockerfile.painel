# Core OS · painel em container (modo Dokploy). Contexto de build: a raiz do repositório.
FROM node:22-bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends bash ca-certificates curl ffmpeg g++ git jq make python3 qrencode \
 && rm -rf /var/lib/apt/lists/*
ARG CODEX_VERSION=0.166.0
RUN npm install -g @openai/codex@${CODEX_VERSION} && codex --version
WORKDIR /app
COPY painel/package.json painel/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY painel/ ./
COPY cerebro-demo/ /app/cerebro-demo/
COPY dokploy/entrypoint.sh /app/entrypoint.sh
RUN rm -rf data && chmod +x /app/entrypoint.sh \
 && mkdir -p /home/node/cerebro /home/node/dados /home/node/.codex \
 && chown -R node:node /home/node
USER node
ENV HOME=/home/node CORE_OS_HOST=0.0.0.0 CORE_OS_PORT=3000 \
    CORE_OS_VAULT=/home/node/cerebro CORE_OS_DATA=/home/node/dados CORE_OS_ENV=/nao-existe \
    EVO_URL=http://evolution:8080 EVO_INSTANCE=cerebro \
    WHATS_WEBHOOK=http://n8n:5678/webhook/core-os-whatsapp TZ=America/Sao_Paulo
EXPOSE 3000
ENTRYPOINT ["/app/entrypoint.sh"]
