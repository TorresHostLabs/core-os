# Core OS · variáveis do modo Dokploy. Cole no Environment do app Compose (ou use ./gerar-env.sh).
# Nenhum valor real aqui. Segredos: openssl rand -hex 24

# --- Cérebro ---
CORE_OS_NOME=
# 1 = cria o cérebro com os 4 exemplos, 0 = vazio (só vale na primeira subida)
CORE_OS_EXEMPLOS=1
# Motor padrão (painel e WhatsApp): codex, claude, openai ou antigravity (só vale na primeira subida)
CORE_OS_MOTOR=codex

# --- Painel ---
# Senha de login: mínimo 8 caracteres, sem espaço, aspas, $, crase nem barra invertida.
# Gerar: openssl rand -base64 18 | tr -d '/+=' | cut -c1-16
CORE_OS_PASSWORD=
# Token entre o n8n e o painel. Gerar: openssl rand -hex 24
CORE_OS_HOOK_TOKEN=
# Chave da API da OpenAI (usada pelo Codex e pelo motor "OpenAI (API)"). Pode ficar vazia e logar depois.
OPENAI_API_KEY=
# WordPress (opcional): o normal é conectar pela tela (Configurações › WordPress). Se preencher os três, valem estes.
# Senha de aplicativo: no WordPress, Usuários › Perfil › Senhas de aplicativo.
WP_URL=
WP_USER=
WP_APP_PASSWORD=

# --- Evolution API e Postgres ---
# Gerar: openssl rand -hex 24
EVO_KEY=
# Gerar: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- n8n ---
# Gerar: openssl rand -hex 24 (não troque depois: as credenciais do n8n ficam cifradas com ela)
N8N_ENCRYPTION_KEY=
# Sem domínio: IP do servidor, http, URL com porta e cookie inseguro.
# Com domínio: n8n.seudominio.com, https, https://n8n.seudominio.com/ e cookie seguro.
N8N_HOST=
N8N_PROTOCOL=http
N8N_PUBLIC_URL=
N8N_SECURE_COOKIE=false

# --- Opcionais ---
# Pasta do cérebro no host. Vazio = ../../files/cerebro (persistente no Dokploy)
CORE_OS_CEREBRO=
# Portas do host (padrão 3100 e 5678). Com domínio, remova as portas e use Domains do Dokploy.
# CORE_OS_PAINEL_PORTA=3100
# N8N_PORTA=5678
